[Unit]
Description=DEV-ONLY: install dev SSH key + passwordless sudo for the torizon user
# Run after the persistent /home is available; before sshd is actually used.
After=local-fs.target home.mount
ConditionPathExists=/usr/share/torizon-ab-devaccess/dev-authorized_keys

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/torizon-ab-devaccess.sh

[Install]
WantedBy=multi-user.target
