#!/bin/sh
# Keep the A/B rootfs slots (and the FAT boot partition) out of BOTH automounters
# (Torizon's usermount + udisks2) so rauc/SWUpdate can raw-write the inactive
# slot. Two jobs:
#   1. Add the slot device nodes to usermount's ignorelist.
#   2. Defensively UNMOUNT any slot/boot partition that a boot-time race already
#      auto-mounted under /media (udisks2 can win the race against its own
#      UDISKS_IGNORE udev rule during early boot). Once unmounted, the udev rule
#      / ignorelist keep it unmounted.
# Slots are resolved by BOTH the ext4 FS label (SWUpdate/x86: otaroot_a|b) and
# the GPT PARTLABEL (RAUC/ARM: rootfs_a|b), so one script serves every machine.
# The active slot (mounted as /) is always left alone.
set -u

LIST="/etc/usermount/ignorelist"
command -v udevadm >/dev/null 2>&1 && udevadm settle || true
mkdir -p /etc/usermount
touch "$LIST"

# Device backing / — never touch the active slot.
ROOTDEV="$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*\]//')"
ROOTREAL="$(readlink -f "$ROOTDEV" 2>/dev/null || echo "$ROOTDEV")"

for path in \
    /dev/disk/by-label/otaroot_a /dev/disk/by-label/otaroot_b \
    /dev/disk/by-partlabel/rootfs_a /dev/disk/by-partlabel/rootfs_b \
    /dev/disk/by-partlabel/boot ; do
    dev="$(readlink -f "$path" 2>/dev/null || true)"
    # only real block devices (skips labels absent on a given machine/backend)
    [ -n "${dev}" ] && [ -b "${dev}" ] || continue

    # 1. usermount ignorelist (dedup)
    grep -xqs "${dev}" "$LIST" || echo "${dev}" >> "$LIST"

    # 2. defensive unmount — but never the active root slot
    [ "${dev}" = "${ROOTREAL}" ] && continue
    if [ -n "$(findmnt -nro TARGET -S "${dev}" 2>/dev/null)" ]; then
        umount "${dev}" 2>/dev/null || umount -l "${dev}" 2>/dev/null || true
    fi
done
exit 0
