[Unit]
Description=Exclude A/B rootfs slots from the automounters (usermount + udisks2)
After=local-fs.target systemd-udevd.service
Before=usermount.service udisks2.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/torizon-ab-slot-ignorelist

[Install]
WantedBy=multi-user.target
