[Unit]
Description=Seed RAUC U-Boot A/B boot-selection env (BOOT_ORDER) if missing
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target greenboot-healthcheck.service
ConditionPathExists=/etc/fw_env.config

[Service]
Type=oneshot
RemainAfterExit=yes
# This early in boot udev may not have created the env device yet.
ExecStartPre=/usr/libexec/torizon-ab/wait-ubootenv
ExecStart=/usr/bin/rauc-ubootenv-create.sh

[Install]
WantedBy=sysinit.target
